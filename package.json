{
  "name": "helix-heresy",
  "version": "1.0.0",
  "description": "Helix Heresy is a desktop-focused static browser prototype about forbidden slime genetics, laboratory discovery, and questionable science.",
  "main": "app.js",
  "scripts": {
    "test": "playwright test --project=chromium --workers=4",
    "test:smoke": "playwright test --project=chromium --workers=4 --grep \"@smoke\"",
    "test:visual": "playwright test tests/canvas-map-renderer.spec.js --project=chromium --grep \"renderer parity fixtures\"",
    "test:visual:update": "playwright test tests/canvas-map-renderer.spec.js --project=chromium --grep \"renderer parity fixtures\" --update-snapshots",
    "benchmark:map": "node scripts/run-map-benchmark.js",
    "benchmark:map:full": "node scripts/run-map-benchmark.js --full"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/depressedtsukasa-hub/Helix-Heresy.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/depressedtsukasa-hub/Helix-Heresy/issues"
  },
  "homepage": "https://github.com/depressedtsukasa-hub/Helix-Heresy#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3"
  }
}
