{
  "name": "helix-heresy",
  "version": "1.0.0",
  "description": "Helix Heresy is a desktop-focused static browser prototype about forbidden slime genetics, laboratory discovery, and questionable science.",
  "main": "app.js",
  "scripts": {
    "test": "playwright test --config=playwright.smoke.config.js",
    "test:smoke": "playwright test --config=playwright.smoke.config.js",
    "test:regression": "playwright test --project=chromium",
    "test:all": "playwright test",
    "test:headed": "playwright test --config=playwright.smoke.config.js --headed",
    "test:ui": "playwright test --config=playwright.smoke.config.js --ui",
    "test:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/depressedtsukasa-hub/Helix-Heresy.git"
  },
  "keywords": [],
